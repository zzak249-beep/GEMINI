# ─── BingX API ───────────────────────────────────────────────
BINGX_API_KEY=your_api_key_here
BINGX_SECRET_KEY=your_secret_key_here

# ─── Telegram ────────────────────────────────────────────────
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Trading ─────────────────────────────────────────────────
# BingX perpetual format: BTC/USDT:USDT,ETH/USDT:USDT
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT
TIMEFRAME=15m
LEVERAGE=5
RISK_PER_TRADE=1.5

# ─── SAMA ────────────────────────────────────────────────────
SAMA_LENGTH=200
SAMA_MAJ_LENGTH=14
SAMA_MIN_LENGTH=6
SLOPE_PERIOD=34
SLOPE_RANGE=25
SLOPE_FLAT=17

# ─── Markov ──────────────────────────────────────────────────
SLOPE_MIN=30.0
LOOKBACK_MARKOV=200
PROB_THRESHOLD=40.0

# ─── ADX Adaptativo ──────────────────────────────────────────
ADX_LEN=14
ADX_TREND=25
ADX_RANGE=20

# ─── Filtros institucionales ─────────────────────────────────
RVOL_MIN=1.5
POC_LOOKBACK=50
PIVOT_LEN=4
LIQUIDITY_LOOKBACK=20

# ─── CVD ─────────────────────────────────────────────────────
CVD_SLOPE_PERIOD=8
CVD_DIVERGENCE_LOOKBACK=10

# ─── Funding Rate ────────────────────────────────────────────
FUNDING_BULL_THRESHOLD=-0.0001
FUNDING_BEAR_THRESHOLD=0.0005

# ─── Kotegawa ────────────────────────────────────────────────
DIP_PCT=20.0
MA_LEN=25
RSI_LEN=14
RSI_OVERSOLD=28.0
BB_LEN=20
BB_MULT=2.0

# ─── Triple barrera ──────────────────────────────────────────
ATR_MULT_TP=2.2
ATR_MULT_SL=1.2
MAX_BARS_HOLD=24

# ─── Scoring ─────────────────────────────────────────────────
MIN_SCORE=55

# ─── Riesgo global ───────────────────────────────────────────
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_POSITIONS=2
LOOP_INTERVAL=60
HEALTH_PORT=8080
