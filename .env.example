# --- BingX (API key SOLO con permisos de lectura + trading de futuros, SIN retiros) ---
BINGX_API_KEY=
BINGX_API_SECRET=

# --- Telegram ---
# Token del bot: hablar con @BotFather
# Chat ID: hablar con @userinfobot (o el bot @RawDataBot) para obtener tu chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Mercado ---
# SYMBOLS = "ALL" escanea TODOS los perpetuos USDT-M de BingX.
# También acepta una lista: "BTC-USDT,ETH-USDT,SOL-USDT"
SYMBOLS=ALL
QUOTE_ASSET_FILTER=USDT
EXCLUDED_SYMBOLS=
SYMBOL_REFRESH_HOURS=24
SCAN_CONCURRENCY=8

TIMEFRAME=15m
TIMEFRAME_MINUTES=15
HISTORY_CANDLES=500

# --- Parámetros de la estrategia (valores por defecto = script Pine original) ---
RSI_LENGTH=10
SIG_LENGTH=10
TRIGGER_LEVEL=50
TARGET_CROSS_COUNT=2
ATR_PERIOD=10
ST_FACTOR=2.5

# --- Filtro de tendencia (de "Higher-Low tras Ruptura + EMA50") ---
# No toma el Doble Dip si el precio sigue en una base sin confirmar: exige
# EMA de tendencia subiendo Y ruptura ya confirmada de la directriz bajista
# de la base previa. Compara con/sin filtro: backtest.py --no-trend-filter
TREND_FILTER_ENABLED=true
TREND_EMA_LENGTH=50
TREND_EMA_SLOPE_LOOKBACK=5
TREND_PIVOT_LEFT=5
TREND_PIVOT_RIGHT=5
TREND_MAX_BARS_AFTER_BREAK=30

# --- Gestión de riesgo ---
# OJO con SYMBOLS=ALL: estos valores se aplican por símbolo y SE APILAN.
# Con los valores de abajo, la exposición máxima teórica en margen es
# MAX_CONCURRENT_POSITIONS x POSITION_SIZE_PCT = 5 x 5% = 25% del balance.
LEVERAGE=3
POSITION_SIZE_PCT=5
STOP_LOSS_PCT=5
MAX_CONCURRENT_POSITIONS=5
SYMBOL_COOLDOWN_MINUTES=60
MAX_CONSECUTIVE_LOSSES=5
CIRCUIT_BREAKER_COOLDOWN_MINUTES=120

# --- Operación ---
# IMPORTANTE: deja DRY_RUN=true hasta confirmar por Telegram que las señales
# se comportan como esperas. Cámbialo a false para operar con dinero real.
DRY_RUN=true
POLL_BUFFER_SECONDS=8
LOG_LEVEL=INFO

# Railway inyecta PORT automáticamente - NO la definas aquí ni en Railway
# (si la fijas a mano puede pisar el puerto que Railway espera y romper el
# dominio público / healthcheck). config.py ya trae 8080 como valor de
# reserva solo para cuando corras el bot fuera de Railway.
