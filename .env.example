# ─────────────────────────────────────────────────────────────────────────────
# ZigZag Institutional Elite V6 — Railway Environment Variables
# Copia este archivo como referencia. En Railway, agrega estas variables en
# Settings → Variables (NUNCA subas este archivo con valores reales a GitHub)
# ─────────────────────────────────────────────────────────────────────────────

# ── BingX API (obtenlas en bingx.com → API Management) ───────────────────────
BINGX_API_KEY=tu_api_key_aqui
BINGX_SECRET_KEY=tu_secret_key_aqui

# ── Telegram (crea bot con @BotFather → obtén token) ─────────────────────────
TELEGRAM_TOKEN=123456789:ABCDefGhIJklMNoPQRsTUVwXyZ
TELEGRAM_CHAT_ID=-100xxxxxxxxxx   # Usa @userinfobot para obtener tu chat_id

# ── Estrategia ────────────────────────────────────────────────────────────────
SYMBOL=BTC-USDT        # Par de trading (formato BingX Futures)
TIMEFRAME=15m          # Temporalidad: 1m 3m 5m 15m 30m 1h 4h 1d

# ── Gestión de riesgo ─────────────────────────────────────────────────────────
RISK_PERCENT=1.0       # % del balance arriesgado por operación (recomendado: 1-2%)
LEVERAGE=5             # Apalancamiento (recomendado: 3-10x máximo)
TP_MULT=2.0            # Multiplicador TP (RR = 1:2.0)

# ── Parámetros ZigZag ─────────────────────────────────────────────────────────
PIVOT_LEN=5            # Profundidad del ZigZag (igual que en Pine Script)
VOL_MULT=1.5           # Multiplicador volumen institucional
ATR_LEN=14             # Periodo ATR

# ── Loop ──────────────────────────────────────────────────────────────────────
LOOP_SECONDS=60        # Segundos entre cada análisis (60 = cada minuto)
