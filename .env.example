# Copia este archivo como ".env" para pruebas en local.
# En Railway, NO subas .env: estas variables se configuran en
# Project -> tu servicio -> pestaña "Variables".

# --- BingX ---
# Genera las API Keys en https://bingx.com/es-es/account/api/
# Permisos recomendados: SOLO lectura + trading de spot. NUNCA actives
# permiso de retiros (withdraw) en una key que uses en un bot.
BINGX_API_KEY=tu_api_key_aqui
BINGX_API_SECRET=tu_api_secret_aqui

# true = usa la red de pruebas de BingX (VST, dinero ficticio). Necesitas
# generar las keys específicamente en modo demo desde tu cuenta de BingX.
# Deja esto en true hasta que hayas verificado que todo funciona bien.
BINGX_DEMO=true

# --- Telegram ---
# 1) Habla con @BotFather en Telegram -> /newbot -> copia el token.
# 2) Escríbele algo a tu bot y luego visita:
#    https://api.telegram.org/bot<TU_TOKEN>/getUpdates
#    para encontrar tu chat_id (o usa @userinfobot para tu chat_id personal).
TELEGRAM_BOT_TOKEN=tu_token_de_botfather
TELEGRAM_CHAT_ID=tu_chat_id

# --- Mercado ---
SYMBOL=BTC/USDT
TIMEFRAME=15m
CANDLES_LOOKBACK=300

# --- Gestión de capital ---
# USDT que se gasta en cada señal de compra.
TRADE_AMOUNT_USDT=100
# Por debajo de este valor en USDT, el bot considera que "no hay posición abierta".
MIN_POSITION_VALUE_USDT=5

# --- Parámetros de la estrategia (valores por defecto = script Pine original) ---
RSI_LENGTH=10
SIGNAL_LENGTH=10
TRIGGER_LEVEL=50
TARGET_CROSS_COUNT=2
ATR_PERIOD=10
ST_FACTOR=2.5

# --- Operativa ---
# true = analiza y avisa por Telegram pero NO envía ninguna orden real a BingX.
# Ponlo en false solo cuando hayas verificado el comportamiento del bot.
DRY_RUN=true
# Segundos de margen tras el cierre de cada vela antes de pedir datos a BingX.
POLL_BUFFER_SECONDS=20
LOG_LEVEL=INFO

# --- Fiabilidad ---
# Reintentos ante errores de red TRANSITORIOS al hablar con BingX (no ante
# errores del exchange como fondos insuficientes, esos nunca se reintentan).
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2
# No repetir el mismo aviso de error en Telegram antes de que pase este tiempo.
ERROR_NOTIFY_COOLDOWN_MINUTES=15

# --- Gestión de riesgo opcional ---
# 0 = desactivado (comportamiento IDÉNTICO al Pine Script original).
# Si lo pones, p. ej., en 5, el bot cerrará la posición si el precio cae un
# 5% desde el precio de entrada, incluso si el SuperTrend no ha girado todavía.
STOP_LOSS_PCT=0

# --- Observabilidad ---
# Horas entre mensajes de "sigo activo" por Telegram. 0 = desactivado.
HEARTBEAT_EVERY_HOURS=24

# --- Comandos remotos por Telegram ---
# true = puedes escribirle /status /pause /resume /close /help a tu bot.
TELEGRAM_COMMANDS_ENABLED=true
