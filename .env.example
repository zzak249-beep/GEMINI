# ─── BingX API ──────────────────────────────────────────────
BINGX_API_KEY=your_bingx_api_key_here
BINGX_SECRET_KEY=your_bingx_secret_key_here

# ─── Telegram ────────────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ─── Temporalidad ─────────────────────────────────────────────
# 1m 3m 5m 15m 30m 1h 2h 4h 6h 1d
INTERVAL=1h

# ─── SAMA Strategy ────────────────────────────────────────────
SAMA_LENGTH=200
MAJ_LENGTH=14
MIN_LENGTH=6
SLOPE_PERIOD=34
SLOPE_RANGE=25
FLAT=17

# ─── Scanner — TODAS las monedas ──────────────────────────────
# Sin límite de símbolos. Solo filtra por volumen mínimo USDT 24h.
# 100000  = $100k  → ~200-250 pares
# 500000  = $500k  → ~100-150 pares
# 1000000 = $1M    → ~60-80 pares
MIN_VOL=100000

# Peticiones paralelas por batch (no subir de 10)
BATCH_SIZE=8
# Pausa entre batches en ms (400-600 recomendado)
BATCH_DELAY_MS=400

# ─── Gestión de posiciones ────────────────────────────────────
MAX_POSITIONS=5
LEVERAGE=5
RISK_PCT=1
TP_PCT=2
SL_PCT=1
MIN_QTY=0.001
QTY_STEP=0.001

# ─── Reportes ─────────────────────────────────────────────────
# Enviar resumen de mercado cada N scans
SUMMARY_EVERY=6
# Hora UTC para el reporte diario completo (0-23)
REPORT_HOUR=8

# ─── Seguridad ────────────────────────────────────────────────
# true = modo papel (sin órdenes reales)
# false = opera con dinero real
DRY_RUN=true
