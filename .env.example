# ═══════════════════════════════════════
#  QF×JP Bot v5.0 — Variables de Entorno
# ═══════════════════════════════════════

BINGX_API_KEY=tu_api_key
BINGX_SECRET=tu_secret
TG_TOKEN=123456:ABCdef...
TG_CHAT_ID=-100123456789

# SIGNAL = solo alertas | LIVE = dinero real
MODE=SIGNAL

# AUTO = escanea todos los pares BingX
SYMBOLS_MODE=AUTO
MIN_VOLUME_USDT=50000000
MAX_SYMBOLS=25

# Solo si SYMBOLS_MODE=MANUAL
SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT,BNB-USDT

# ── Riesgo ───────────────────────────
LEVERAGE=10
RISK_PCT=1.0
MAX_DD_PCT=5.0
MAX_POSITIONS=5
TP_RR=2.0

# ── Umbrales señal ───────────────────
SCORE_THR_LONG=0.63
SCORE_THR_SHORT=0.63
DECAY_THR=0.65

# ── Convicción mínima (0-14) ─────────
MIN_CONV_STD=6
MIN_CONV_FUEL=7
MIN_CONV_SUP=9

# ── Profit Factor mínimo ─────────────
MIN_PF=1.5
PF_WINDOW=20

# ── Maker orders (reduce fees 73%) ───
USE_MAKER=true

# ── Backtester rolling (WFO) ─────────
BACKTEST=true
BACKTEST_INTERVAL=21600

# ── Sesiones: NY, LDN, ASIA ──────────
SESSIONS=NY,LDN
LOOP_INTERVAL=30
SCANNER_INTERVAL=3600
