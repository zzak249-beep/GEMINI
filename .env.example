# ==========================================
# BINGX API
# ==========================================
BINGX_API_KEY=tu_api_key_aqui
BINGX_SECRET_KEY=tu_secret_key_aqui

# ==========================================
# TELEGRAM
# ==========================================
TELEGRAM_TOKEN=123456789:AAAA...
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# ==========================================
# ZIGZAG CANAL
# ==========================================
PIVOT_LEN=5
ATR_LEN=14
TIMEFRAME=3m

# ==========================================
# CHANNEL FADE V32
# ==========================================
SHORT_PIPS=45
LONG_PIPS=30
SL_ATR_MULT=1.5
MIN_RR=1.5

# ==========================================
# FILTROS V32
# ==========================================
ADX_MIN=25
ADX_LEN=14
EMA_FAST=7
EMA_MED=17
EMA_SLOW=21
VOL_FILTER=true
VOL_MULT=1.5
TIME_STOP_MINUTES=45

# ==========================================
# GESTIÓN DE RIESGO — DINERO REAL
# FASE 1 (0-20 trades): LEVERAGE=5  RISK_PCT=1.0  MAX_POSITIONS=2
# FASE 2 (20+ trades con % positivo): LEVERAGE=7  RISK_PCT=1.5  MAX_POSITIONS=3
# FASE 3 (consolidado): LEVERAGE=10  RISK_PCT=2.0  MAX_POSITIONS=3
# ==========================================
LEVERAGE=5
RISK_PCT=1.0
MAX_POSITIONS=2
MAX_DAILY_LOSS=4.0

# ==========================================
# SCANNER
# WHITELIST_ONLY=true → solo pares de alta liquidez (RECOMENDADO)
# WHITELIST_ONLY=false → scan dinámico (solo para pruebas)
# ==========================================
WHITELIST_ONLY=true
TOP_PAIRS=12
MIN_QUOTE_VOL=50000000
MIN_PRICE_USDT=0.01

# ==========================================
# TIMING
# ==========================================
CANDLE_SLEEP=60
KLINE_LIMIT=120
PORT=8080
