# ==========================================
# BINGX API — Genera en: Account > API Management
# ==========================================
BINGX_API_KEY=tu_api_key_aqui
BINGX_SECRET_KEY=tu_secret_key_aqui

# ==========================================
# TELEGRAM — BotFather + getUpdates para chat_id
# ==========================================
TELEGRAM_TOKEN=123456789:AAAA...
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# ==========================================
# ZIGZAG CANAL
# ==========================================
PIVOT_LEN=5
ATR_LEN=14
TIMEFRAME=3m

# ==========================================
# CHANNEL FADE V32
# ==========================================
SHORT_PIPS=45
LONG_PIPS=30
PIP_SIZE=0.001
SL_ATR_MULT=1.5

# ==========================================
# FILTROS V32 — APEX QUANTUM SHIELD
# Recomendado: no tocar hasta tener 50+ trades de historial
# ==========================================
ADX_MIN=25
ADX_LEN=14
EMA_FAST=7
EMA_MED=17
EMA_SLOW=21
VOL_FILTER=true
VOL_MULT=1.5
TIME_STOP_MINUTES=45

# ==========================================
# GESTIÓN DE RIESGO — DINERO REAL
# Empieza con RISK_PCT=1.0 y MAX_POSITIONS=2
# ==========================================
LEVERAGE=10
RISK_PCT=1.5
MAX_POSITIONS=3
MAX_DAILY_LOSS=5.0

# ==========================================
# SCANNER — 15 pares es el óptimo para 3m real money
# ==========================================
TOP_PAIRS=15
MIN_PRICE_USDT=0.001

# ==========================================
# TIMING
# ==========================================
CANDLE_SLEEP=60
KLINE_LIMIT=120
PORT=8080
