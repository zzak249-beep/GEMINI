# Copy this file to .env for local runs (`cp .env.example .env`) and fill
# in your own values. On Railway, set these under your service's
# Variables tab instead — Railway does not read .env files, it injects
# real environment variables.
#
# ────────────────────────────────────────────────────────────────────────
# SAFETY DEFAULTS: as shipped, this file has DRY_RUN=true and no API keys,
# so the bot will run in signal-only mode and cannot place a real order no
# matter what else is misconfigured. Change those two things deliberately,
# not by accident.
# ────────────────────────────────────────────────────────────────────────

# ── BingX ──────────────────────────────────────────────────────────────
# Create keys at bingx.com > API Management. You MUST tick "Perpetual
# Futures Trading" permission on the key, or live orders will fail with
# an authorization error even though the key works for reading data.
# Do NOT enable withdrawal permission on this key.
BINGX_API_KEY=
BINGX_API_SECRET=

MARKET_TYPE=swap
SYMBOL=BTC/USDT:USDT
TIMEFRAME=5m
LEVERAGE=3

# The master safety switch. true = compute signals against real market
# data and log/notify what the bot WOULD have done, but never call
# create_order. Only set to false once you've watched it run correctly
# for a while and you accept the risk of real capital.
DRY_RUN=true

# ── Strategy (mirrors the Pine script inputs 1:1) ─────────────────────
LOOKBACK_ENERGY=40
K_DOMINANCE=1.5
COOLDOWN_BARS=4
USE_VOL_FILTER=false
VOL_LEN=20
VOL_MULT=1.2

# ── Risk management ────────────────────────────────────────────────────
QTY_PCT=10
USE_ATR_SL=true
ATR_LENGTH=14
ATR_MULT_SL=1.5
ATR_MULT_TP=2.5
SL_PERCENT=1.0
TP_PERCENT=2.0
USE_TRAIL=false
TRAIL_TRIGGER_ATR=1.0
TRAIL_OFFSET_ATR=1.0

# Circuit breaker: halts new entries for the rest of the UTC day once
# equity drawdown from that day's starting balance hits this percentage.
# Existing open positions keep their own SL/TP; this only blocks new ones.
MAX_DAILY_LOSS_PCT=5

# ── Telegram ────────────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram, send /newbot, copy the token below.
# 2. Send any message to your new bot, then open in a browser:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the "chat":{"id": ...} value below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Loop ────────────────────────────────────────────────────────────────
POLL_SECONDS=30
LOG_LEVEL=INFO
