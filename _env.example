# ═══════════════════════════════════════════════════════
#  VARIABLES RAILWAY — CVD BOT  (copiar tal cual, sin comentarios)
# ═══════════════════════════════════════════════════════

# ── OBLIGATORIAS ────────────────────────────────────────
BINGX_API_KEY=TU_API_KEY_AQUI
BINGX_SECRET_KEY=TU_SECRET_KEY_AQUI
TELEGRAM_TOKEN=TU_BOT_TOKEN_AQUI
TELEGRAM_CHAT_ID=TU_CHAT_ID_AQUI

# ── MODO ESCÁNER ─────────────────────────────────────────
SYMBOL_MODE=scanner
SCANNER_MIN_VOLUME=5000000
SCANNER_TOP_N=20
SCANNER_BLACKLIST=
SCANNER_REFRESH_CYCLES=20

# ── OPERATIVA ────────────────────────────────────────────
LEVERAGE=10
RISK_PER_TRADE=0.015
MAX_POSITIONS=3
DAILY_LOSS_LIMIT=0.06

# ── SL / TP ──────────────────────────────────────────────
SL_ATR_MULT=1.5
TP_RR=2.5
TRAIL_ATR_MULT=1.0

# ── ESTRATEGIA — VALORES RELAJADOS PARA MÁS SEÑALES ─────
SCORE_THR=0.10
DECAY_THR=0.30
CVD_DIV_BARS=5
REQUIRE_HTF=false
COOLDOWN_CANDLES=3

# ── RAILWAY ──────────────────────────────────────────────
PORT=8080
