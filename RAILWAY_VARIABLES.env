# ============================================================================
# PLANTILLA DE VARIABLES PARA RAILWAY — Wavelet MRA Haar 5m Bot
# ============================================================================
# Cómo usarla:
#   1. Railway -> tu servicio -> pestaña "Variables" -> botón "Raw Editor"
#   2. Pega TODO este bloque de una vez
#   3. Rellena los valores vacíos (BINGX_*, TELEGRAM_*, WEBHOOK_SECRET)
#   4. Save -> Railway redeploya solo
#
# Las líneas que empiezan por # son comentarios, Railway las ignora.
# No subas este archivo relleno a GitHub (usa el .env.example del repo,
# que no lleva tus claves).
# ============================================================================

# ---------------------------------------------------------------------------
# BingX — API de trading
# ---------------------------------------------------------------------------
# Crea la key en BingX con permiso de FUTUROS/TRADING activado y
# RETIRO DESACTIVADO. Pégala sin espacios ni saltos de línea al final.
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_BASE_URL=https://open-api.bingx.com
BINGX_DEMO=true

# ---------------------------------------------------------------------------
# Telegram — para las señales
# ---------------------------------------------------------------------------
# Token: habla con @BotFather -> /newbot
# Chat ID: habla con @userinfobot, o manda un mensaje a tu bot y consulta
#          https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Webhook (solo necesario si algún día usas SIGNAL_SOURCE=tradingview)
# ---------------------------------------------------------------------------
# Genera uno random: openssl rand -hex 24
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Modo de operación
# ---------------------------------------------------------------------------
# false = SOLO manda señales a Telegram, no toca dinero real. EMPIEZA AQUÍ.
# true  = ejecuta las órdenes en BingX de verdad.
AUTO_TRADE=false

# ---------------------------------------------------------------------------
# Origen de la señal
# ---------------------------------------------------------------------------
# python:       el bot calcula la señal solo, leyendo velas de BingX cada
#               5 min. NO necesita plan de pago de TradingView. (recomendado)
# tradingview:  usa el webhook de TradingView (requiere plan Essential+).
SIGNAL_SOURCE=python
ENABLE_SCHEDULER=true

# Símbolos a vigilar, formato BingX BASE-QUOTE separados por coma.
# Ejemplos: BTC-USDT   |   BTC-USDT,ETH-USDT   |   BTC-USDT,ETH-USDT,SOL-USDT
# O escribe ALL para vigilar TODOS los perpetuos USDT de BingX automáticamente.
SYMBOLS=BTC-USDT
SCAN_ALL_MAX_SYMBOLS=150
SCAN_ALL_REFRESH_HOURS=6

# Resumen periódico por Telegram con el estado del filtro en todo lo
# vigilado (no ejecuta nada, solo informa) -- muy útil junto con SYMBOLS=ALL
SCAN_REPORT_ENABLED=false
SCAN_REPORT_INTERVAL_HOURS=4

# ---------------------------------------------------------------------------
# Parámetros del filtro Wavelet MRA Haar (equivalentes a los inputs del Pine)
# ---------------------------------------------------------------------------
WAVELET_LOOKBACK_ENERGY=40
WAVELET_K_DOMINANCE=1.5
WAVELET_COOLDOWN_BARS=4
WAVELET_ATR_LENGTH=14
WAVELET_ATR_MULT_SL=1.5
WAVELET_ATR_MULT_TP=2.5

# ---------------------------------------------------------------------------
# Riesgo / tamaño de posición
# ---------------------------------------------------------------------------
RISK_PCT_PER_TRADE=2.0
LEVERAGE=10
MAX_CONCURRENT_POSITIONS=1

# ---------------------------------------------------------------------------
# Circuit breaker
# ---------------------------------------------------------------------------
MAX_CONSECUTIVE_LOSSES=4
MAX_DAILY_DRAWDOWN_PCT=6.0

# ---------------------------------------------------------------------------
# Persistencia
# ---------------------------------------------------------------------------
STATE_FILE=state.json
