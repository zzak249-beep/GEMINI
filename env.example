# ── BingX API ──────────────────────────────────────────
BINGX_API_KEY=tu_api_key_aqui
BINGX_SECRET_KEY=tu_secret_key_aqui

# ── Telegram ────────────────────────────────────────────
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# ── Estrategia Channel Fade ─────────────────────────────
PIVOT_LEN=5            # Profundidad ZigZag
ATR_LEN=14             # Periodo ATR para SL
TIMEFRAME=3m           # Timeframe (3 minutos)

SHORT_PIPS=45          # Pips encima de GREEN para SHORT
LONG_PIPS=30           # Pips debajo de RED para LONG
PIP_SIZE=1.0           # Valor de 1 pip: BTC=1.0, ETH=0.1, alts=0.001
SL_ATR_MULT=2.0        # SL = entrada ± ATR × este valor

VOL_FILTER=false       # true = requiere vol > VOL_MULT×SMA20
VOL_MULT=1.5           # solo aplica si VOL_FILTER=true

# ── Gestión de riesgo ───────────────────────────────────
LEVERAGE=10
RISK_PCT=1.5           # % del balance por trade
MAX_POSITIONS=5
MAX_DAILY_LOSS=5.0     # % máximo de pérdida diaria

# ── Scanner ─────────────────────────────────────────────
TOP_PAIRS=20
MIN_PRICE_USDT=0.001

# ── Timing ──────────────────────────────────────────────
CANDLE_SLEEP=60        # 60s = revisar cada vela de 3m
KLINE_LIMIT=120        # 120 velas = 6h de histórico en 3m
